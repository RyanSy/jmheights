# ── Contact Form (Resend) ─────────────────────────────────────────────────────
RESEND_API_KEY=
CONTACT_EMAIL_TO=
CONTACT_EMAIL_FROM=

# ── Google Business Profile (Reviews) ────────────────────────────────────────
# OAuth 2.0 credentials — Google Cloud Console → APIs & Services → Credentials
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Long-lived refresh token — obtained via the one-time local auth flow in README
GOOGLE_OAUTH_REFRESH_TOKEN=

# Resource names from the Business Profile API (e.g. accounts/123456789)
GOOGLE_BUSINESS_ACCOUNT_ID=
GOOGLE_BUSINESS_LOCATION_ID=

# ── Site ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://jmheights.com